{
  "name": "ff1-rpg",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 vitest run",
    "test:fast": "vitest run --project fast",
    "test:full": "NODE_OPTIONS=--max-old-space-size=8192 vitest run",
    "test:world": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --project world",
    "validate": "npx tsx scripts/validate-content.ts",
    "quest": "NODE_OPTIONS=--max-old-space-size=8192 vite-node scripts/quest-verify.ts",
    "assets": "python3 -I assets-src/build_assets.py"
  },
  "dependencies": {
    "pixi.js": "^8.0.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "jsdom": "^29.0.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  }
}
